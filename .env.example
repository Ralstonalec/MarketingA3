# Copy to .env (or export these). Anything set here overrides the Settings page.
PORT=3000
HOST=127.0.0.1
# Login. REQUIRED when HOST is not localhost (the app refuses to start without it).
# Set these in your host's environment settings. Never commit real values.
APP_USERNAME=
APP_PASSWORD=

OPENROUTER_API_KEY=
HIGGSFIELD_KEY=
CUSTOM_API_KEY=
